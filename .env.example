# Copy this file to .env and fill in your values:
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (macOS / Linux)
# .env is git-ignored, so your values never reach GitHub.

# Which cloud to review designs for and which model service to call: oci or aws.
CLOUD=oci

# The model to use. Set a per-cloud override so you can flip CLOUD on its own
# without editing anything else. Falls back to MODEL_ID if the override is unset.
OCI_MODEL_ID=meta.llama-3.3-70b-instruct
# Run check_aws.py - it prints the exact IDs your account can call.
# Models needing cross-region inference take a us. / eu. / apac. prefix.
AWS_MODEL_ID=amazon.nova-lite-v1:0
# MODEL_ID=

# ---- OCI only ----
# Credentials come from ~/.oci/config, which must stay outside this repo.
COMPARTMENT_ID=ocid1.compartment.oc1..replace-me
# Optional: only if the model is in a different region from your OCI config file
# GENAI_REGION=us-chicago-1

# ---- AWS only ----
# Credentials come from ~/.aws/credentials, which must stay outside this repo.
# Optional: only if you want a different region from your AWS config.
# AWS_REGION=eu-west-1

# Optional: set to 1 to use the fake model (no cloud calls, no cost)
# USE_FAKE_LLM=1
